# 旅行规划 Agent · 内测 v1.3 环境变量示例
# 复制为 .env 后按需填写；未设置的项使用默认值。

# 服务监听地址与端口
HOST=0.0.0.0
PORT=8080

# CORS 白名单（逗号分隔）。留空表示允许所有来源（仅建议本地/内测使用）。
# 例如：ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=

# 基础限流：单 IP 在时间窗内的最大请求数。RATE_LIMIT_MAX=0 表示关闭限流。
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# 密钥（放在这里，切勿提交到 git；.gitignore 已忽略 .env）。
# 前端仍保留可输入接口：请求未携带 key 时，后端回退到以下环境变量。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
MAPS_API_KEY=

# 是否把上面的密钥下发给前端做「预填输入框」（仅自测便利）。
# true：自测时页面自动带上你的 key，仍可手动修改；
# false（正式上线务必用 false）：前端不接收密钥，由每个用户自行填写。
EXPOSE_KEYS_TO_FRONTEND=false

# v1.3 自动修复闭环：收敛控制参数
# MAX_REPAIR_ROUNDS：单次规划最多修复轮数（默认 3）；NO_IMPROVE_LIMIT：连续无改善多少轮即停并兜底（默认 2）。
MAX_REPAIR_ROUNDS=3
NO_IMPROVE_LIMIT=2

# v1.3 状态机可视化调试端点 GET /api/debug/last-trace 开关。
# true（内测默认）：可查询最近一次规划的完整 trace；false（正式上线建议）：关闭该端点。
ENABLE_DEBUG_TRACE=true
